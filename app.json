{
  "expo": {
    "name": "Orazaka",
    "slug": "orazaka-mobile",
    "owner": "oussamaabid",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "orazaka",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krizaka.orazaka",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:dev.orazaka.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0e14"
      },
      "package": "com.krizaka.orazaka",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dev.orazaka.com",
              "pathPrefix": "/chat"
            },
            {
              "scheme": "https",
              "host": "dev.orazaka.com",
              "pathPrefix": "/jobs"
            },
            {
              "scheme": "https",
              "host": "dev.orazaka.com",
              "pathPrefix": "/settings"
            },
            {
              "scheme": "https",
              "host": "dev.orazaka.com",
              "pathPrefix": "/studios"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "./plugins/with-xcode27",
      [
        "expo-image-picker",
        {
          "photosPermission": "Orazaka reads the photos you choose to start a creation from.",
          "cameraPermission": "Orazaka uses the camera when you take a photo to start a creation from."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27da30b2-57a8-4f97-a985-be044a5d2e09"
      }
    }
  }
}
