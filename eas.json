{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_EDGE_URL": "https://dev.orazaka.com/edge"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_EDGE_URL": "https://dev.orazaka.com/edge"
      }
    },
    "production": {},
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_EDGE_URL": "https://dev.orazaka.com/edge"
      },
      "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6825100921"
      }
    }
  }
}
